diff --git a/Dumper/Engine/Private/Unreal/NameArray.cpp b/Dumper/Engine/Private/Unreal/NameArray.cpp
index ff3ec91..e1f18fe 100644
--- a/Dumper/Engine/Private/Unreal/NameArray.cpp
+++ b/Dumper/Engine/Private/Unreal/NameArray.cpp
@@ -423,6 +423,42 @@ bool NameArray::TryFindNamePool_Windows()
 
 	// TODO (encryqed): Fix this below for 32-bit ue games ig?
 
+#if defined(_WIN64)
+	/*
+	 * UE5.7 emits a compact GetNamePool accessor before the constructor
+	 * reference used by the older discovery path:
+	 *
+	 *   cmp  byte ptr [initialized], 0
+	 *   je   construct
+	 *   lea  rax, [NamePool]
+	 *   ...
+	 *   lea  rcx, [NamePool]
+	 *   call FNamePool::FNamePool
+	 *
+	 * Resolve the first LEA directly. This is intentionally a fallback
+	 * signature for an engine code shape, not a game-specific RVA.
+	 */
+	constexpr const char* GetNamePoolAccessorSignature =
+		"48 83 EC 28 80 3D ? ? ? ? 00 74 ? "
+		"48 8D 05 ? ? ? ? EB ? 48 8D 0D ? ? ? ? E8";
+	constexpr uint32 GetNamePoolLeaDisplacementOffset = 0x10;
+
+	if (void* AccessorNamePool = Platform::FindPattern(
+		GetNamePoolAccessorSignature,
+		GetNamePoolLeaDisplacementOffset))
+	{
+		const uintptr_t Address =
+			reinterpret_cast<uintptr_t>(AccessorNamePool);
+		if (Platform::IsAddressInProcessRange(Address)
+			&& !Platform::IsBadReadPtr(AccessorNamePool))
+		{
+			Off::InSDK::NameArray::GNames =
+				Platform::GetOffset(Address);
+			return true;
+		}
+	}
+#endif
+
 	/* Number of bytes we want to search for an indirect call to InitializeSRWLock */
 	constexpr int32 InitSRWLockSearchRange = 0x50;
 
